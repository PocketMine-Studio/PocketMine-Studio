<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/toolbar_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:ellipsize="middle"
        android:gravity="center"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_action_copy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy"
                android:src="@drawable/ic_content_copy_24px" />

            <ImageButton
                android:id="@+id/btn_action_rename"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rename"
                android:src="@drawable/ic_edit_24px" />

            <ImageButton
                android:id="@+id/btn_action_permissions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Permissions"
                android:src="@drawable/ic_settings_24px" />

            <ImageButton
                android:id="@+id/btn_action_archive"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Archive"
                android:src="@drawable/ic_folder_zip_24px" />

            <ImageButton
                android:id="@+id/btn_action_download"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Download"
                android:src="@drawable/ic_share_24px" />

            <ImageButton
                android:id="@+id/btn_action_select"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Select"
                android:src="@drawable/ic_check_small_24px" />

            <ImageButton
                android:id="@+id/btn_action_delete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:src="@drawable/ic_delete_24px" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>

